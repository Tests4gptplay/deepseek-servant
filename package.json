{
  "name": "deepseek-servant",
  "version": "0.1.0-alpha.20",
  "description": "基于 DeepSeek Harness 的自主 AI 助理与多 Agent 协作插件，支持目标规划、持续执行、任务接续、故障恢复与技能学习。\n\n设计逻辑源自 Chat Agent Harness（CAH）：https://github.com/Tests4gptplay/chat-agent-harness",
  "private": true,
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "icon.png",
    "assets/page-icon.png",
    "assets/statusbar-icon.png",
    "assets/statusbar-icon-black.png",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "IMPLEMENTATION.md",
    "RETENTION.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-storage-json": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/deepseek-servant.git"
  },
  "homepage": "https://github.com/Tests4gptplay/deepseek-servant#readme",
  "icon": "./icon.png"
}
