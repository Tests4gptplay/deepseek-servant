{
  "name": "deepseek-servant",
  "version": "0.3.6",
  "description": "基于 DeepSeek Harness 的自主 AI 助理与多 Agent 协作插件，支持目标规划、持续执行、任务接续、故障恢复与技能学习。\n\n设计逻辑源自 Chat Agent Harness（CAH）：https://github.com/Tests4gptplay/chat-agent-harness",
  "private": true,
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.png"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "icon.png",
    "assets/page-icon.png",
    "assets/welcome-character.png",
    "assets/task-empty-character.png",
    "assets/statusbar-icon.png",
    "assets/statusbar-icon-black.png",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SPONSOR.md",
    "PRIVATE_GIT.md",
    "IMPLEMENTATION.md",
    "RETENTION.md",
    "docs/INSTALLATION.md",
    "docs/USAGE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:history-ui": "node scripts/test-history-ui.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-preset-registry": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-storage-json": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-working-directory": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-code-language": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.1-rc.2",
    "@shikijs/langs": "^4.5.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "esbuild": "^0.25.12",
    "immer": "^10.1.1",
    "jsdom": "^30.1.3",
    "katex": "^0.18.10",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "shiki": "^4.5.0",
    "simple-icons": "^16.31.0",
    "typescript": "^6.0.3",
    "zustand": "~4.5.7"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/deepseek-servant.git"
  },
  "homepage": "https://github.com/Tests4gptplay/deepseek-servant#readme",
  "icon": "./icon.png"
}
