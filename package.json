    "lib/native-cleaner/windows-storage-backend.mjs",
    "lib/dulwich-helper.py",
    "docs/MEMORY_GIT.md",
    "docs/ATTACHMENTS.md",
    "python/requirements.txt",
    "python/SHA256SUMS",
    "python/licenses/Dulwich-COPYING",
    "python/licenses/urllib3-LICENSE.txt",
    "upgrades/g09-skills-once.json"
