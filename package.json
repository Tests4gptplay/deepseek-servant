{
  "name": "deepseek-servant",
  "version": "0.5.0-rc.3",
  "description": "DeepSeek Harness Local/Git 协作助理：原生六角色执行、持久会话、任务恢复与成果归档。",
  "private": true,
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.png",
    "./cleaner": "./lib/native-cleaner/entry.mjs"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "icon.png",
    "assets/page-icon.png",
    "assets/welcome-character.png",
    "assets/task-empty-character.png",
    "assets/statusbar-mask.webp",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SPONSOR.md",
    "PRIVATE_GIT.md",
    "RETENTION.md",
    "docs/INSTALLATION.md",
    "docs/USAGE.md",
    "THIRD_PARTY_NOTICES.md",
    "lib/native-cleaner/plugin.mjs",
    "lib/native-cleaner/coordinator.mjs",
    "lib/native-cleaner/jsonl-adapter.mjs",
    "lib/native-cleaner/cache-domain.mjs",
    "lib/native-cleaner/retirement-store.mjs",
